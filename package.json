{
  "name": "@dsh-plugin/dsh-claude-provider",
  "version": "0.7.0",
  "description": "Custom Claude provider support for DeepSeek Harness 0.2.2-rc.2 and 0.2.2-rc.3",
  "author": "mofeng2223",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoFeng2223/dsh-claude-provider.git"
  },
  "homepage": "https://github.com/MoFeng2223/dsh-claude-provider#readme",
  "bugs": {
    "url": "https://github.com/MoFeng2223/dsh-claude-provider/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "claude",
    "anthropic"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "js-yaml": "^4.3.2"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./migrate-legacy-types": {
      "types": "./lib/migrate-legacy-types.d.ts",
      "default": "./lib/migrate-legacy-types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-client.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.2-rc.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3"
  }
}
